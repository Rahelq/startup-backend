# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=startup_connect
DB_PASSWORD=123456
DB_PORT=5432

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_secret_key_change_in_production
REFRESH_TOKEN_DAYS=30

# Cloudinary (profile & document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend base URL for password reset links in email
PUBLIC_APP_URL=http://localhost:5173

# Zoom Integration
ZOOM_ENABLED=true
ZOOM_USER_ID=your_zoom_user_id
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Chapa Payment Gateway
CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_RETURN_URL=http://localhost:3000
CHAPA_CALLBACK_URL=your_ngrok_or_production_url/api/payments/webhooks/chapa
CHAPA_BASE_URL=https://api.chapa.co/v1

# Email (if using Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# Logging
LOG_LEVEL=debug
