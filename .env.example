DB_USER=your_db_user
DB_HOST=your_db_host
DB_NAME=your_db_name
DB_PASSWORD=your_db_password
DB_PORT=5432

ZOOM_ENABLED=true
ZOOM_USER_ID=your_zoom_user_id
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

CHAPA_PUBLIC_KEY=your_chapa_public_key
CHAPA_SECRET_KEY=your_chapa_secret_key
CHAPA_RETURN_URL=http://localhost:3000
CHAPA_CALLBACK_URL=https://your-ngrok-or-domain/api/payments/webhooks/chapa
CHAPA_BASE_URL=https://api.chapa.co/v1

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Secret for signing authentication tokens (keep this secret and same for all instances)
JWT_SECRET=your_jwt_secret

# Public app URL used for email links (password reset, notifications, etc)
PUBLIC_APP_URL=http://localhost:3000

# Render Postgres connection details (example placeholders only)
# Hostname your_render_db_host
# Port 5432
# Database your_render_db_name
# Username your_render_db_user
# Password your_render_db_password
